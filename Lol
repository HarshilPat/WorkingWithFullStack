@Test
public void ctor_messageLS_null_usesDefaultPath() {
    Throwable ex = new Throwable("boom");
    LocaleString title = new LocaleString();

    try (MockedStatic<JOptionPane> pane = Mockito.mockStatic(JOptionPane.class)) {
        pane.when(() -> JOptionPane.showOptionDialog(
                any(), any(), any(), anyInt(), anyInt(), any(), any(), any()))
            .thenReturn(0);

        // use the 3-arg constructor with messageLS = null
        ExceptionDialog dialog = new ExceptionDialog(
                (LocaleString) title,
                (LocaleString) null,
                ex
        );

        Assert.assertNotNull(dialog);
    }
}

@Test
public void ctor_messageLS_notNull_branch() {
    Throwable ex = new Throwable("boom");
    LocaleString title = new LocaleString();

    LocaleString mockLS = mock(LocaleString.class, RETURNS_DEEP_STUBS);
    when(mockLS.getString(anyString()).getText(any())).thenReturn("msg-text");

    try (MockedStatic<JOptionPane> pane = Mockito.mockStatic(JOptionPane.class)) {
        pane.when(() -> JOptionPane.showOptionDialog(
                any(), any(), any(), anyInt(), anyInt(), any(), any(), any()))
            .thenReturn(0);

        // use the 3-arg constructor with a non-null messageLS
        ExceptionDialog dialog = new ExceptionDialog(title, mockLS, ex);

        Assert.assertNotNull(dialog);
        verify(mockLS, atLeastOnce()).getString(anyString());
    }
}

@Test
public void ctor_userChoosesDetails_branch() {
    Throwable ex = new Throwable("boom");
    LocaleString title = new LocaleString();
    LocaleString messageLS = new LocaleString();

    try (MockedStatic<JOptionPane> pane = Mockito.mockStatic(JOptionPane.class);
         MockedConstruction<ExceptionDetailsDialog> details =
                 Mockito.mockConstruction(ExceptionDetailsDialog.class)) {

        pane.when(() -> JOptionPane.showOptionDialog(
                any(), any(), any(), anyInt(), anyInt(), any(), any(), any()))
            .thenReturn(1); // simulate clicking "Details"

        // again, use the real 3-arg constructor
        new ExceptionDialog(title, messageLS, ex);

        Assert.assertEquals(details.constructed().size(), 1,
                "Expected ExceptionDetailsDialog to be created");
    }
}
