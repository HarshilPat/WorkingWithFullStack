package ca.gc.cra.alse.trustsearchclient.tool;

import org.mockito.MockedStatic;
import org.mockito.Mockito;
import org.testng.Assert;
import org.testng.annotations.Test;

import ca.gc.cra.rccr.lang.LocaleString;

import static org.mockito.Mockito.*;

public class RHDescriptionManagerTest {

    RHDescriptionManager sut = RHDescriptionManager.getInstance();

    @Test
    public void getInstanceTest() {
        Assert.assertNotNull(sut);
    }

    @Test
    public void getDescription_cacheHit_returnsFromMap() {
        // Arrange
        RHLookUpTable lookupTable = mock(RHLookUpTable.class);
        when(lookupTable.getFullCodeKey()).thenReturn("KEY1");

        LocaleString expected = new LocaleString("cached");
        // put directly into the map (simulate cache hit)
        sut.descriptionMap.put("KEY1", expected);

        // Act
        LocaleString result = sut.getDescription(lookupTable);

        // Assert
        Assert.assertEquals(result, expected);
    }

    @Test
    public void getDescription_cacheMiss_fetchesFromRHLookupTool() {
        // Arrange
        RHLookUpTable lookupTable = mock(RHLookUpTable.class);
        when(lookupTable.getFullCodeKey()).thenReturn("KEY2");

        RHCode rhCode = mock(RHCode.class);
        LocaleString expected = new LocaleString("from-rhcode");
        when(rhCode.getDescription()).thenReturn(expected);

        try (MockedStatic<RHLookupTool> toolMock = Mockito.mockStatic(RHLookupTool.class)) {
            toolMock.when(() -> RHLookupTool.getCode(lookupTable))
                    .thenReturn(rhCode);

            // Act
            LocaleString result = sut.getDescription(lookupTable);

            // Assert
            Assert.assertEquals(result, expected);

            // Verify it was cached for future calls
            Assert.assertEquals(sut.descriptionMap.get("KEY2"), expected);
        }
    }
}
