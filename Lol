import org.mockito.MockedStatic;
import org.mockito.Mockito;
import org.testng.Assert;
import org.testng.annotations.Test;

import javax.swing.*;
import java.time.LocalDateTime;

import static org.mockito.Mockito.*;

public class ExceptionDialogTest implements IResource {

    @Test
    public void testConstructor_messageLS_null_usesStringRetriever() {
        Throwable ex = new Throwable("boom");

        try (MockedStatic<JOptionPane> paneMock = Mockito.mockStatic(JOptionPane.class);
             MockedStatic<StringRetriever> strMock = Mockito.mockStatic(StringRetriever.class)) {

            // mock JOptionPane to simulate user pressing OK (index 0)
            paneMock.when(() -> JOptionPane.showOptionDialog(
                    any(), any(), any(), anyInt(), anyInt(), any(), any(), any()))
                    .thenReturn(0);

            // mock StringRetriever
            strMock.when(() -> StringRetriever.getString(anyString(), anyString()))
                   .thenReturn("retrieved-message");

            // create dialog with messageLS == null
            ExceptionDialog dialog = new ExceptionDialog(
                    (Component) null,
                    new LocaleString("test"),
                    null,
                    ex
            );

            Assert.assertNotNull(dialog);
        }
    }

    @Test
    public void testConstructor_messageLS_notNull() {
        Throwable ex = new Throwable("boom");

        LocaleString mockLS = mock(LocaleString.class);
        when(mockLS.getString(anyString())).thenReturn(new LocaleString("translated"));

        try (MockedStatic<JOptionPane> paneMock = Mockito.mockStatic(JOptionPane.class)) {
            paneMock.when(() -> JOptionPane.showOptionDialog(
                    any(), any(), any(), anyInt(), anyInt(), any(), any(), any()))
                    .thenReturn(0);

            ExceptionDialog dialog = new ExceptionDialog(
                    (Component) null,
                    new LocaleString("title"),
                    mockLS,
                    ex
            );

            Assert.assertNotNull(dialog);
            verify(mockLS, atLeastOnce()).getString(anyString());
        }
    }

    @Test
    public void testConstructor_userChoosesDetails_opensDetailsDialog() {
        Throwable ex = new Throwable("boom");
        LocaleString mockLS = new LocaleString("details-test");

        try (MockedStatic<JOptionPane> paneMock = Mockito.mockStatic(JOptionPane.class)) {
            // Simulate user clicking "Details" (index 1)
            paneMock.when(() -> JOptionPane.showOptionDialog(
                    any(), any(), any(), anyInt(), anyInt(), any(), any(), any()))
                    .thenReturn(1);

            ExceptionDialog dialog = new ExceptionDialog(
                    (Component) null,
                    new LocaleString("title"),
                    mockLS,
                    ex
            );

            Assert.assertNotNull(dialog);
        }
    }
}
